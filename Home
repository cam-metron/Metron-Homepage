<style>
  @import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=Inter:wght@400;500;600&display=swap');

  .arc-page {
    --navy: #10223A;
    --navy-mid: #1B3A5C;
    --line: #E7ECEF;
    --paper: #F1EEE4;
    --steel: #7C8A96;
    --orange: #DD6A2E;
    --radius: 2px;

    font-family: 'Inter', -apple-system, sans-serif;
    color: var(--line);
    background: var(--navy);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .arc-page * { box-sizing: border-box; }
  .arc-page h1, .arc-page h2, .arc-page h3 {
    font-family: 'Big Shoulders Display', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 0.95;
    margin: 0;
  }
  .arc-section {
    padding: 88px 24px;
    border-bottom: 1px solid rgba(231,236,239,0.12);
  }
  .arc-inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .arc-eyebrow-row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 28px;
  }
  .arc-tag {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: var(--orange);
    border: 1px solid var(--orange);
    padding: 3px 10px;
    border-radius: var(--radius);
    white-space: nowrap;
  }
  .arc-rule { flex: 1; height: 1px; background: rgba(231,236,239,0.2); }
  .arc-lede {
    max-width: 62ch;
    font-size: 18px;
    color: var(--steel);
  }

  /* HERO */
  .arc-hero {
    padding-top: 72px;
    padding-bottom: 64px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
  }
  .arc-hero h1 {
    font-size: clamp(46px, 7vw, 84px);
  }
  .arc-hero-sub {
    margin-top: 24px;
    font-size: 19px;
    max-width: 46ch;
    color: var(--line);
  }
  .arc-hero-meta {
    margin-top: 32px;
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }
  .arc-meta-item { font-size: 14px; color: var(--steel); }
  .arc-meta-item b { display: block; color: var(--line); font-size: 15px; font-weight: 600; }
  .arc-cta-row { margin-top: 40px; display: flex; gap: 16px; flex-wrap: wrap; }
  .arc-btn {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 15px;
    padding: 14px 26px;
    border-radius: var(--radius);
    text-decoration: none;
    border: 1px solid transparent;
  }
  .arc-btn-primary { background: var(--orange); color: #1A1006; }
  .arc-btn-ghost { border-color: rgba(231,236,239,0.4); color: var(--line); }

  /* GEAR GRAPHIC */
  .arc-gear-wrap { position: relative; display: flex; justify-content: center; }
  .arc-gear-wrap svg { width: 100%; max-width: 380px; height: auto; }
  .arc-dim-text { font-family: 'Inter', sans-serif; font-size: 11px; fill: var(--steel); letter-spacing: 0.03em; }
  .arc-dim-line { stroke: var(--steel); stroke-width: 1; }
  .arc-gear-fill { fill: none; stroke: var(--line); stroke-width: 2; }
  .arc-gear-accent { fill: var(--orange); }

  /* PROCESS */
  .arc-process-grid {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(231,236,239,0.14);
  }
  .arc-process-cell {
    background: var(--navy);
    padding: 28px 24px;
  }
  .arc-step-no {
    font-family: 'Big Shoulders Display', sans-serif;
    font-size: 15px;
    color: var(--orange);
    font-weight: 700;
  }
  .arc-process-cell h3 { font-size: 22px; margin-top: 10px; }
  .arc-process-cell p { margin-top: 10px; color: var(--steel); font-size: 15px; }

  /* SPEC TABLE — paper section */
  .arc-paper {
    background: var(--paper);
    color: var(--navy);
    border-bottom: 1px solid rgba(16,34,58,0.1);
  }
  .arc-paper .arc-lede { color: #4A5560; }
  .arc-paper .arc-tag { color: var(--navy-mid); border-color: var(--navy-mid); }
  .arc-paper .arc-rule { background: rgba(16,34,58,0.15); }
  table.arc-spec {
    width: 100%;
    border-collapse: collapse;
    margin-top: 36px;
    font-size: 15px;
  }
  table.arc-spec th, table.arc-spec td {
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(16,34,58,0.15);
  }
  table.arc-spec th {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--navy-mid);
  }
  table.arc-spec td.mono { font-variant-numeric: tabular-nums; }
  .arc-spec-note { margin-top: 16px; font-size: 13px; color: #6B7580; }

  /* MARKETS */
  .arc-markets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 44px; }
  .arc-market h3 { font-size: 26px; }
  .arc-market p { margin-top: 8px; color: var(--steel); font-size: 15px; }

  /* CONTACT */
  .arc-contact { text-align: left; }
  .arc-contact h2 { font-size: clamp(38px, 6vw, 60px); }
  .arc-contact-row {
    margin-top: 36px;
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
  }
  .arc-contact-item a { color: var(--line); text-decoration: none; border-bottom: 1px solid var(--orange); }
  .arc-contact-item .label { display: block; font-size: 13px; color: var(--steel); margin-bottom: 4px; }
  .arc-foot {
    padding: 28px 24px;
    font-size: 13px;
    color: var(--steel);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 780px) {
    .arc-hero { grid-template-columns: 1fr; }
    .arc-gear-wrap { order: -1; }
    .arc-process-grid { grid-template-columns: 1fr; }
    .arc-markets { grid-template-columns: 1fr; gap: 28px; }
  }
</style>

